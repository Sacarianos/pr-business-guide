    border-bottom: 1px solid var(--rule);
  }
  /* The tool (0002, G-33): a header row, then questions on the left and
     the route on the right above 1080px, one column below. */
  .tool-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 36px;
