    }
  }

  /* The questions hold still while a long route scrolls past them, which
     is what lets a reader change an answer and watch the route react. Only
     above 1080px: stacked, the column would pin itself over the route. */
  .questions {
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 24px;
  }
  @media (max-width: 1080px) {
    .questions {
      position: static;
    }
  }
  .question[hidden] {
    display: none;
  }

  /* G-28: the progress rail, three stages across, each topped by a bar
     that turns ink when current and brand once complete. */
  .stage-rail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-bottom: 28px;
  }
  .stage-rail:empty {
    display: none;
  }
  /* `:global()`: tool.ts builds the rail's buttons with innerHTML, so
     Astro never stamps them with this component's scoping attribute and a
     scoped selector would silently miss them. That was the bug behind the
     unstyled stage buttons measured on 2026-09-27. */
  :global(.stage-step) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 44px;
    padding: 12px 0 0;
    border: 0;
    border-top: 3px solid var(--rule);
    background: none;
    color: var(--ink-3);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }
  :global(.stage-step:hover) {
    color: var(--ink);
  }
  :global(.stage-step:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  :global(.stage-step[data-state='done']) {
    border-top-color: var(--brand);
    color: var(--ink-2);
  }
  :global(.stage-step[data-state='current']) {
    border-top-color: var(--ink);
    color: var(--ink);
  }
  :global(.stage-count) {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* One rule between each pair of visible questions. `~` over visible
     siblings rather than `+`, since hidden questions from other stages sit
     between them in the markup. */
  .question:not([hidden]) ~ .question:not([hidden]) {
    border-top: 1px solid var(--rule);
    padding-top: 28px;
    margin-top: 28px;
  }
  .question-label {
