---
// The ten-question flow (G-08) and the patente estimator it surfaces
// (G-09), followed by the process overview diagram (G-10), the step cards'
// agency/timing/cost/blocks fields (G-11, rendered client-side in
// src/scripts/tool.ts), and the entity comparison table (G-12). Content is
// server-rendered from content/*.yaml — only the question panel needs
// client JS; the entity table needs none, since it doesn't depend on the
// reader's answers.
import { loadContent } from '../lib/load-content';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import {
  practiceAttribution,
  practiceHeadline,
  professionalLabel,
} from '../lib/sourcing-label';
import { researchDateLabel, researchDateShort } from '../lib/freshness';
import {
  answersToQuery,
  buildSequence,
  groupByPhase,
  patenteLabel,
  routeHeading,
  routeSummary,
  SAMPLE_ANSWERS,
} from '../lib/decision-tree';

const content = await loadContent();

// The hero's sample route (0002, G-32), built here at build time from the
// same logic and content the tool uses, so the first screen can't drift
// from what the tool would actually say for these answers.
const sampleResult = buildSequence(SAMPLE_ANSWERS, content);
const sampleHeading = routeHeading(SAMPLE_ANSWERS, content);
const sampleSummary = routeSummary(sampleResult);
const sampleStops = groupByPhase(sampleResult, content)
  .flatMap((g) => g.stops)
  .filter((stop) => stop.number !== null)
  .slice(0, 4);
const sampleMore = sampleSummary.steps - sampleStops.length;
const samplePatente = patenteLabel(sampleSummary.patente);
const sampleHref = `?${answersToQuery(SAMPLE_ANSWERS, content.questions)}#ruta`;

// Proof numbers under the headline: how much the guide documents, and when
// it was last checked. `other` is the catch-all municipio with no rates.
const proofSteps = Object.keys(content.steps).length;
const proofMunicipios = Object.keys(content.municipios).filter((id) => id !== 'other').length;

// Sorted by each entry's own `order` field (least to most structure: sole →
// LLC → corporación) rather than content/entities.yaml's key order, which
// YAML doesn't guarantee is preserved through the loader — same reason
// `questions` carries an `order` field and is sorted the same way.
const entities = Object.entries(content.entities)
  .map(([id, e]) => ({ id, ...e }))
  .sort((a, b) => a.order - b.order);

// Embedded so the client script has content immediately, with no extra
// request race against G-04's published content.json (that asset is for
// cud-agente, a different consumer with a different lifecycle — fetching
// it here would just be a second, slower copy of what SSR already has).
// `<`-escaping keeps a literal `</script>` inside any note's HTML
// from ever being able to close this tag early.
const contentJson = JSON.stringify(content).replace(/</g, '\\u003c');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guía de Apertura de Negocios en Puerto Rico</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    {
      /* G-19: apply a saved language preference before first paint, the same
      technique a dark-mode toggle uses to avoid a flash of the wrong theme —
      here, a flash of the wrong language. Inline and blocking, not a module,
      so it runs before the browser paints anything below. */
    }
    <script is:inline>
      (function () {
        var lang = 'es';
        try {
          if (localStorage.getItem('pr-guia-lang') === 'en') lang = 'en';
        } catch (e) {}
        document.documentElement.dataset.lang = lang;
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="#">
          <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
            <rect width="28" height="28" rx="7" fill="var(--brand)" />
            <circle cx="9" cy="9" r="3" fill="none" stroke="#fff" stroke-width="2" />
            <circle cx="19" cy="19" r="3" fill="var(--mark)" />
            <path d="M9 12v2a5 5 0 0 0 5 5h2" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" />
          </svg>
          <b>
            <span lang="es">Guía de Apertura</span>
            <span lang="en">Opening Guide</span>
          </b>
          <span class="brand-place">Puerto Rico</span>
        </a>
        <nav class="nav" aria-label="Secciones / Sections">
          <a href="#ruta"><span lang="es">Arma tu ruta</span><span lang="en">Build your route</span></a>
          <a href="#proceso"><span lang="es">El proceso</span><span lang="en">The process</span></a>
          <a href="#entidades"><span lang="es">Formas legales</span><span lang="en">Legal forms</span></a>
          <a href="#limites"><span lang="es">Lo que no sabemos</span><span lang="en">What we don't know</span></a>
        </nav>
        <div class="lang-toggle" role="group" aria-label="Idioma / Language">
          <button type="button" class="lang-btn" data-lang-option="es" aria-pressed="true">ES</button>
          <button type="button" class="lang-btn" data-lang-option="en" aria-pressed="false">EN</button>
        </div>
      </div>
    </header>

    <section class="hero" data-hero>
      <div class="wrap hero-inner">
        <div>
          <p class="eyebrow">
            <span lang="es">Guía gratuita · No es asesoría legal</span>
            <span lang="en">Free guide · Not legal advice</span>
          </p>
          <h1>
            <span lang="es">Todo lo que necesitas para abrir tu negocio en Puerto Rico, <em>en orden.</em></span>
            <span lang="en">Everything you need to open a business in Puerto Rico, <em>in order.</em></span>
          </h1>
          <p class="lead">
            <span lang="es">
              Contesta diez preguntas y te decimos qué trámites te tocan, en qué agencia, cuánto
              cuestan y qué va primero. Gratis y sin registrarte.
            </span>
            <span lang="en">
              Answer ten questions and we tell you which procedures apply to you, at which agency,
              what they cost and what comes first. Free, with no sign-up.
            </span>
          </p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href="#ruta">
              <span lang="es">Arma tu ruta</span><span lang="en">Build your route</span>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <a class="btn btn-ghost btn-lg" href={sampleHref} data-see-example>
              <span lang="es">Ver un ejemplo</span><span lang="en">See an example</span>
            </a>
          </div>
          <div class="proof">
            <div>
              <strong data-proof="steps">{proofSteps}</strong>
              <span><span lang="es">trámites documentados</span><span lang="en">documented procedures</span></span>
            </div>
            <div>
              <strong data-proof="municipios">{proofMunicipios}</strong>
              <span><span lang="es">municipios con tarifas</span><span lang="en">municipalities with rates</span></span>
            </div>
            <div>
              <strong>
                <span lang="es" data-proof="date">{researchDateShort('es')}</span>
                <span lang="en">{researchDateShort('en')}</span>
              </strong>
              <span><span lang="es">última verificación</span><span lang="en">last verified</span></span>
            </div>
          </div>
        </div>

        <aside class="sample" data-sample-route aria-label="Ruta de ejemplo / Sample route">
          <div class="sample-head">
            <p class="eyebrow"><span lang="es">Ejemplo</span><span lang="en">Example</span></p>
            <h2 class="sample-title">
              <span lang="es">{sampleHeading.title.es}</span>
              <span lang="en">{sampleHeading.title.en}</span>
            </h2>
            <p class="sample-subline">
              <span lang="es">{sampleHeading.subline.es}</span>
              <span lang="en">{sampleHeading.subline.en}</span>
            </p>
          </div>
          <dl class="sample-stats">
            <div>
              <dt><span lang="es">Trámites</span><span lang="en">Procedures</span></dt>
              <dd>{sampleSummary.steps}</dd>
            </div>
            <div>
              <dt><span lang="es">Recurrentes</span><span lang="en">Recurring</span></dt>
              <dd>{sampleSummary.recurring}</dd>
            </div>
            <div>
              <dt><span lang="es">Patente est.</span><span lang="en">Est. patente</span></dt>
              <dd>
                <span lang="es">{samplePatente.es}</span>
                <span lang="en">{samplePatente.en}</span>
              </dd>
            </div>
          </dl>
          <ol class="sample-route">
            {
              sampleStops.map((stop) => (
                <li
                  class="sample-stop"
                  data-stop={stop.id}
                  data-severity={stop.severity ?? ''}
                  data-sourcing={stop.sourcing}
                >
                  <span class="pin">{stop.number}</span>
                  <div>
                    <h3 class="sample-stop-title">
                      <span lang="es">{stop.title.es}</span>
                      <span lang="en">{stop.title.en}</span>
                    </h3>
                    <p class="sample-stop-meta">
                      <span lang="es">{stop.agency.es}</span>
                      <span lang="en">{stop.agency.en}</span>
                    </p>
                  </div>
                  <span class="sample-stop-cost">
                    <span lang="es">{stop.cost.es === '—' ? '' : stop.cost.es}</span>
                    <span lang="en">{stop.cost.en === '—' ? '' : stop.cost.en}</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <div class="sample-foot" data-sample-more={sampleMore}>
            <span>
              <span lang="es">y {sampleMore} trámites más</span>
              <span lang="en">and {sampleMore} more procedures</span>
            </span>
            <a href={sampleHref}>
              <span lang="es">Ver la ruta completa</span><span lang="en">See the full route</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <main class="tool" id="ruta">
      <div class="wrap">
      <div class="tool-head">
        <div>
          <p class="eyebrow">
            <span lang="es">Tu ruta · 2 minutos</span>
            <span lang="en">Your route · 2 minutes</span>
          </p>
          <h2 class="tool-title">
            <span lang="es">Contesta y la ruta se arma sola.</span>
            <span lang="en">Answer, and the route builds itself.</span>
          </h2>
        </div>
        {/* G-20: the single-location assumption, stated where the reader
            starts answering rather than left to be discovered later. */}
        <p class="assumption-note">
          <span lang="es">
            <strong>Supone un solo local en un municipio.</strong> El volumen se atribuye por
            municipio, el Registro de Comerciantes es por local, y el 1% municipal del IVU sigue
            el municipio de la venta. Si operas en más de uno, úsala como punto de partida.
          </span>
          <span lang="en">
            <strong>Assumes a single location in one municipality.</strong> Volume is attributed
            per municipality, the Registro de Comerciantes is per location, and the municipal 1%
            IVU follows the municipality of the sale. If you operate in more than one, treat this
            as a starting point.
          </span>
        </p>
      </div>
      <div class="tool-grid">
        {
          /* G-19: the question panel and results are re-rendered by
          src/scripts/tool.ts on every answer change already, so tool.ts also
          owns re-labeling this subtree's text on a language change, rather
          than the dual-span/CSS technique the rest of the page uses, since
          `<select><option>` text and `aria-label` attributes can't hold a
          hidden alternate-language span. `data-i18n` marks the plain static
          strings tool.ts swaps by key (src/scripts/tool.ts's UI_TEXT). */
        }
        <div class="questions" data-questions>
          {/* G-28: the progress rail. Rendered client-side by
              src/scripts/tool.ts, since which stage is current and how many
              of its questions are answered are both runtime state. Server
              output is an empty nav, so a reader with no JS still gets
              every question below it (the blocks start unhidden). */}
          <nav class="stage-rail" data-stage-rail aria-label="Progreso / Progress"></nav>
          {
            content.questions.map((q) => (
              <div class="question" data-question={q.id}>
                <label class="question-label">{q.label.es}</label>
                {q.hint && <p class="question-hint">{q.hint.es}</p>}
                {/* G-27: progressive disclosure, GOV.UK `details` pattern,
                    closed by default so the panel stays scannable, and inline
                    rather than a tooltip so it works on touch and reads to a
                    screen reader. Sits between the question and its answers
                    so an opened explainer reads before the choice it explains. */}
                {q.help && (
                  <details class="q-help">
                    <summary data-help-summary>{q.help.summary.es}</summary>
                    <div class="q-help-body" data-help-body set:html={q.help.body.es} />
                  </details>
                )}
                {q.input === 'options' && (
                  <div
                    class:list={['options', { 'options-2': (q.options?.length ?? 0) % 2 === 0 }]}
                    role="group"
                    aria-label={q.label.es}
                  >
                    {q.options?.map((o) => (
                      <button type="button" class="option" data-option={o.value} aria-pressed="false">
                        <span class="option-label">{o.label.es}</span>
                        {o.detail && <span class="option-detail" set:html={o.detail.es} />}
                      </button>
                    ))}
                  </div>
                )}
                {q.input === 'select' && (
                  <select aria-label={q.label.es}>
                    <option value="" data-i18n="selectPlaceholder">Escoge un municipio</option>
                    {q.options?.map((o) => <option value={o.value}>{o.label.es}</option>)}
                  </select>
                )}
                {q.input === 'number' && (
                  <input type="number" min="0" step="1" inputmode="numeric" placeholder="$" aria-label={q.label.es} />
                )}
              </div>
            ))
          }
          <div class="stage-nav">
            <span class="stage-next-hint" data-stage-hint></span>
            <button type="button" class="btn btn-ghost" data-stage-prev hidden>Atrás</button>
            <button type="button" class="btn btn-primary" data-stage-next>Continuar</button>
          </div>
          <button type="button" class="start-over" data-start-over data-i18n="startOver">
            Empezar de nuevo
          </button>
        </div>

        <div class="panel" data-route>
          <div class="panel-head">
            <div>
              <p class="eyebrow" data-i18n="routeEyebrow">Tu ruta</p>
              <h3 class="route-heading" data-route-heading>Tu negocio</h3>
              <p class="route-subline" data-route-subline></p>
            </div>
            <div class="panel-actions" data-route-actions hidden>
              <button type="button" class="action-btn" data-copy-link data-i18n="copyLink">Copiar enlace</button>
              <button type="button" class="action-btn" data-print data-i18n="print">Imprimir</button>
            </div>
          </div>
          {/* G-35: where "Copiar enlace" reports back. If the clipboard write
              is refused, the link appears here, selected, to copy by hand. */}
          <div class="copy-feedback">
            <p class="copy-status" data-copy-status aria-live="polite"></p>
            <input class="copy-fallback" type="text" readonly data-copy-fallback hidden aria-label="Enlace / Link" />
          </div>
          {/* Before three answers the panel still shows what's coming: the
              five phases the route will fill, muted. */}
          <div class="route-empty" data-route-empty>
            <p class="route-empty-text" data-i18n="emptyState">
              Contesta 3 preguntas y tu ruta aparece aquí.
            </p>
            <ol class="phase-placeholders">
              {
                (Object.keys(content.phases) as (keyof typeof content.phases)[])
                  .sort((x, y) => content.phases[x].order - content.phases[y].order)
                  .map((id) => (
                    <li class="phase-placeholder" data-phase-placeholder>
                      <span lang="es">{content.phases[id].title.es}</span>
                      <span lang="en">{content.phases[id].title.en}</span>
                    </li>
                  ))
              }
            </ol>
          </div>
          <div class="route-body" data-results hidden>
            <dl class="summary" data-summary-strip></dl>
            <div class="patente-note" data-patente-note></div>
            <div class="zones" data-zones></div>
            <div class="finish">
              <span class="finish-flag" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <div>
                <b data-i18n="finishTitle">Listo para abrir</b>
                <span data-i18n="finishText">Revisa los incentivos antes de radicar.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
    </main>

    {/* The incentives band (0002, G-36): only the incentives that apply to
        the reader's answers, so it stays hidden until there are results. */}
    <section class="incentives-band" id="incentivos" data-incentives-band hidden>
      <div class="wrap">
        <p class="eyebrow"><span lang="es">Incentivos que te tocan</span><span lang="en">Incentives that apply to you</span></p>
        <h2 class="band-title"><span lang="es">Lo que puedes ahorrarte.</span><span lang="en">What you can save.</span></h2>
        <p class="band-dek">
          <span lang="es">Solo los que aplican a tus respuestas, cada uno con la ley que lo crea.</span>
          <span lang="en">Only the ones that apply to your answers, each with the law that creates it.</span>
        </p>
        <div class="cards" data-incentives></div>
      </div>
    </section>

    <section class="diagram-section" id="proceso">
      <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span lang="es">El proceso</span><span lang="en">The process</span></p>
        <h2>
          <span lang="es">La forma del proceso</span>
          <span lang="en">The shape of the process</span>
        </h2>
      </div>
      <p class="section-dek">
        <span lang="es">
          Dos cadenas corren en paralelo y terminan en un solo permiso. La de arriba es papeleo:
          días, y casi gratis. La de abajo es la que se lleva los meses.
        </span>
        <span lang="en">
          Two chains run in parallel and end in a single permit. The one on top is paperwork:
          days, and nearly free. The one on the bottom is the one that eats the months.
        </span>
      </p>
      <figure class="diagram-figure">
        <div class="diagram-frame">
          <ProcessDiagram />
        </div>
        <figcaption>
          <span lang="es">
            Las dos cadenas son independientes hasta que se encuentran. Lo que la gente hace mal
            es la flecha marcada en ámbar: el Certificado de Registro de Comerciante es un
            <em>insumo</em> de la solicitud de permiso, así que quien deja Hacienda para el final
            descubre que no puede radicar. Las obligaciones municipales y patronales cuelgan del
            mismo punto pero no bloquean nada — la patente se notifica <em>después</em> de
            empezar, no antes.
          </span>
          <span lang="en">
            The two chains are independent until they meet. What people get wrong is the arrow
            marked in amber: the Certificado de Registro de Comerciante is an <em>input</em> to
            the permit application, so anyone who leaves Hacienda for last finds they can't file.
            The municipal and employer obligations hang off the same point but block nothing — the
            patente is notified <em>after</em> starting, not before.
          </span>
        </figcaption>
      </figure>
      </div>
    </section>

    <section class="entities-section" id="entidades">
      <div class="wrap">
      <div class="section-head">
        <p class="eyebrow"><span lang="es">Formas legales</span><span lang="en">Legal forms</span></p>
        <h2>
          <span lang="es">DBA, LLC o corporación</span>
          <span lang="en">DBA, LLC, or corporation</span>
        </h2>
      </div>
      <p class="section-dek">
        <span lang="es">
          La forma legal de la pregunta 2 define casi todo lo que sigue. Esta es la comparación
          completa, no solo la rama que te tocó.
        </span>
        <span lang="en">
          The legal form from question 2 defines almost everything that follows. This is the full
          comparison, not just the branch you landed on.
        </span>
      </p>
      <div class="entities-table-wrap">
        <table class="entities-table">
          <thead>
            <tr>
              <th scope="col"><span lang="es">Forma</span><span lang="en">Form</span></th>
              <th scope="col">
                <span lang="es">Protección de bienes</span><span lang="en">Asset protection</span>
              </th>
              <th scope="col"><span lang="es">Radicación</span><span lang="en">Filing</span></th>
              <th scope="col">
                <span lang="es">Contribución por defecto</span><span lang="en">Default tax</span>
              </th>
              <th scope="col">
                <span lang="es">Costo de formación</span><span lang="en">Formation cost</span>
              </th>
              <th scope="col">
                <span lang="es">Obligación anual</span><span lang="en">Annual obligation</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              entities.map((e) => (
                <Fragment>
                  <tr>
                    <th scope="row">
                      <span lang="es">{e.name.es}</span>
                      <span lang="en">{e.name.en}</span>
                      {e.professional && (
                        <span class="entities-professional">
                          <span lang="es">→ Consulta con {professionalLabel(e.professional, 'es')}</span>
                          <span lang="en">→ Talk to {professionalLabel(e.professional, 'en')}</span>
                        </span>
                      )}
                    </th>
                    <td><span lang="es">{e.liability.es}</span><span lang="en">{e.liability.en}</span></td>
                    <td><span lang="es">{e.filing.es}</span><span lang="en">{e.filing.en}</span></td>
                    <td>
                      <span lang="es" set:html={e.defaultTax.es} />
                      <span lang="en" set:html={e.defaultTax.en} />
                    </td>
                    <td>
                      <span lang="es">{e.formationCost.es}</span>
                      <span lang="en">{e.formationCost.en}</span>
                    </td>
                    <td>
                      <span lang="es" set:html={e.annualObligation.es} />
                      <span lang="en" set:html={e.annualObligation.en} />
                    </td>
                  </tr>
                  {e.practice && (practiceHeadline(e.practice.status, 'es') || practiceHeadline(e.practice.status, 'en')) && (
                    <tr class="entities-practice-row">
                      <td colspan="6">
                        <p class={`practice-banner practice-${e.practice.status}`}>
                          <span lang="es">
                            <strong>{practiceHeadline(e.practice.status, 'es')}</strong>{' '}
                          </span>
                          <span lang="en">
                            <strong>{practiceHeadline(e.practice.status, 'en')}</strong>{' '}
                          </span>
                          <span class="practice-attribution">
                            {practiceAttribution(e.practice)}
                          </span>
                        </p>
                      </td>
                    </tr>
                  )}
                </Fragment>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="entities-notes">
        {
          entities
            .filter((e) => e.note)
            .map((e) => (
              <p class="entities-note">
                <span lang="es" set:html={`<strong>${e.name.es}:</strong> ${e.note!.es}`} />
                <span lang="en" set:html={`<strong>${e.name.en}:</strong> ${e.note!.en}`} />
              </p>
            ))
        }
      </div>
      </div>
    </section>

    <section class="gaps-section" id="limites">
      <div class="wrap">
      {/* G-17: research date and freshness stamp. Moved here from under the
          old masthead (0002): the hero shows the date, and the reason the
          date matters belongs with the list of what couldn't be verified. */}
      <div class="vigencia">
        <p class="eyebrow"><span lang="es">Vigencia</span><span lang="en">Currency</span></p>
        <p class="vigencia-body">
