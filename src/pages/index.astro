  /* G-20: the single-location assumption, stated where the reader starts
     answering rather than left to be discovered the hard way. */
  .assumption-note {
    margin: 0;
    max-width: 30em;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
